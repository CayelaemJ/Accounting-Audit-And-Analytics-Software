# Use a PostgreSQL role without BYPASSRLS. TLS is required in hosted environments.
DATABASE_URL=postgresql://cabo_app:REPLACE_ME@localhost:5432/cabo_financial
NODE_ENV=development

# 64-character hex random secret used to protect bank statement source identifiers.
# Do not commit real keys or rotate without a planned source re-binding migration.
BANK_SOURCE_HMAC_KEY=
